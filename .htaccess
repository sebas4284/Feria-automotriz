# Hostinger (y hosting compartido en general) despliega este repo completo
# en la raíz pública del sitio, en vez de solo la carpeta /public de Laravel.
# Este archivo redirige internamente todo el tráfico hacia /public, sin
# exponer app/, .env, vendor/, etc. y sin cambiar la URL visible.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
